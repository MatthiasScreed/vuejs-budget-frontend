# ==========================================
# PRODUCTION ENVIRONMENT - CoinQuest
# ==========================================

# ==========================================
# MODE DE DÉPLOIEMENT
# ==========================================
VITE_DEPLOYMENT_MODE=production
VITE_BUILD_MODE=production
VITE_DEBUG=false
VITE_DEBUG_MODE=false
VITE_DEBUG_API=false

# ==========================================
# URLS API PRODUCTION
# ==========================================
# ⚠️ À REMPLACER PAR VOS VRAIES URLs DE PRODUCTION
VITE_API_BASE_URL=https://api.coinquest.fr
VITE_APP_URL=https://coinquest.fr

# ==========================================
# 🏦 BANKING INTEGRATION PRODUCTION
# ==========================================
# URLs de callback pour Bridge (production)
VITE_BANKING_SUCCESS_URL=https://laravel-budget-api-saqbqlbw.on-forge.com/api/bank/callback?success=true
VITE_BANKING_ERROR_URL=https://laravel-budget-api-saqbqlbw.on-forge.com/api/bank/callback?error=true
VITE_BANKING_CALLBACK_URL=https://laravel-budget-api-saqbqlbw.on-forge.com/api/bank/callback
VITE_BANKING_DEFAULT_PROVIDER=bridge

# Bridge Configuration
# ⚠️ NE PAS METTRE LES SECRETS ICI - Utiliser .env.production.local
VITE_BRIDGE_ENVIRONMENT=production
VITE_BRIDGE_REDIRECT_URI=https://vuejs-budget-frontend-uyz0rvnb.on-forge.com/app/banking

# ==========================================
# APPLICATION INFO
# ==========================================
VITE_APP_NAME="CoinQuest"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Gestionnaire de budget gamifié"

# ==========================================
# API CONFIGURATION
# ==========================================
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# ==========================================
# 🎮 GAMING FEATURES
# ==========================================
VITE_BANKING_MIN_LEVEL=3
VITE_ADVANCED_FEATURES_MIN_LEVEL=10
VITE_XP_TRANSACTION=5
VITE_XP_GOAL_ACHIEVED=50
VITE_XP_STREAK_BONUS=10

# ==========================================
# 🔐 SÉCURITÉ & AUTH
# ==========================================
VITE_TOKEN_REFRESH_INTERVAL=1800000
VITE_TOKEN_WARNING_THRESHOLD=300000
VITE_REMEMBER_ME_DURATION=7776000000

# ==========================================
# 🎨 UI/UX CONFIGURATION
# ==========================================
VITE_DEFAULT_THEME=light
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LANGUAGE=fr

# Performance
VITE_ENABLE_ANIMATIONS=true
VITE_LAZY_LOADING=true
VITE_PWA_ENABLED=true

# ==========================================
# 📊 ANALYTICS & MONITORING
# ==========================================
VITE_LOG_LEVEL=error
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=""

# ==========================================
# 🔧 FONCTIONNALITÉS
# ==========================================
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Banking avancé
VITE_ENABLE_BANK_CATEGORIZATION_AI=true
VITE_ENABLE_EXPENSE_PREDICTIONS=true
VITE_ENABLE_BUDGET_ALERTS=true

# Gaming avancé
VITE_ENABLE_MULTIPLAYER_CHALLENGES=false
VITE_ENABLE_LEADERBOARDS=true
VITE_ENABLE_SOCIAL_FEATURES=false

# ==========================================
# ⚠️ SECRETS
# ==========================================
# Les secrets (API keys, tokens, etc.) doivent être dans .env.production.local
# Ce fichier .env.production.local NE DOIT PAS être commité dans Git
